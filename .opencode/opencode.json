{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "Chrome DevTools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com",
        "disabled": false
      }
    }
  },
  "policies": [
    {
      "action": "skill.use",
      "resource": "code-review",
      "effect": "deny"
    },
    {
      "action": "skill.use",
      "resource": "autofix",
      "effect": "deny"
    }
  ]
}

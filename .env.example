# Contact form — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender identity. "Display Name <address>" or bare address.
CONTACT_NOTIFICATION_FROM_NAME="Arvi's Mail System"
CONTACT_AUTO_REPLY_FROM_NAME="Arvianto Wicaksono"
CONTACT_FROM_EMAIL="noreply@inquiry.arvian.to"

# Owner notification recipient (your inbox).
CONTACT_TO=dev@arvian.to

# Abuse throttling — optional, sane defaults apply (5 submissions / 10 minutes).
# Limit: submissions per window, integer >= 1 (invalid/0 -> default 5).
# Window: minutes, integer >= 1 (invalid/0 -> default 10).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MIN=10

# Availability badge — all booleans: empty/false/0 (case-insensitive) = off,
# anything else = on. Resolution: AVAIL_IS_CLOSED forced red > AVAIL_LOOKING_FOR_JOB
# green > any toggle yellow (label lists the active ones) > nothing set = red default.
# Add the ones you mean to your real .env (and Vercel project envs in prod) —
# every listed var starts off, so an empty .env shows red like before.
# Rare-moment switch: forces red over everything; delete the line to restore normal flow.
AVAIL_IS_CLOSED=
# Green: actively looking for a new job. Overrides the open-type toggles.
AVAIL_LOOKING_FOR_JOB=
# Yellow inputs (any one on -> yellow, badge reads "Open to <active ones>").
AVAIL_FREELANCE=
AVAIL_PARTNERSHIP=
AVAIL_OPEN_TO_OFFER=


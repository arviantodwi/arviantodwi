# Contact form — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender identity. "Display Name <address>" or bare address.
CONTACT_NOTIFICATION_FROM_NAME="Arvi's Mail System"
CONTACT_AUTO_REPLY_FROM_NAME="Arvianto Wicaksono"
CONTACT_FROM_EMAIL="noreply@inquiry.arvian.to"

# Owner notification recipient (your inbox).
CONTACT_TO=dev@arvian.to

# Abuse throttling — optional, sane defaults apply (5 submissions / 10 minutes).
# Limit: submissions per window, integer >= 1 (invalid/0 -> default 5).
# Window: minutes, integer >= 1 (invalid/0 -> default 10).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MIN=10

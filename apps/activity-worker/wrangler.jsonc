{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activity-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACTIVITY_TZ": "Asia/Jakarta",
    "ALLOWED_ORIGINS": "https://arvian.to",
    "JEV_BASE_URL": "https://ai.sumopod.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-activity",
      // Live production database (verified 2026-11-24). Recreate only via
      // `pnpm db:create` and a follow-up `pnpm db:migrate` on remote.
      "database_id": "077b30bd-66c5-48c0-b6a7-07146591aa16",
      "migrations_dir": "migrations"
    }
  ],
  // Deploy-time: mount this worker at the /activity/* path of the existing
  // zone (arvian.to is already in Cloudflare). CI deploys with this route on
  // every worker change; secrets are managed via `wrangler secret put`:
  "routes": [{ "pattern": "api.arvian.to/activity/*", "zone_name": "arvian.to" }]
}

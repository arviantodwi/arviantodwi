# Agent Activity Worker — environment template
#
# Copy to `.dev.vars` (gitignored) for local dev and fill real values yourself.
# NEVER commit real values: production secrets go to Cloudflare via
# `wrangler secret put AGENT_ACTIVITY_TOKEN` / `wrangler secret put OPENROUTER_API_KEY`.

# Bearer token guarding POST /activity/turns and POST /activity/mcp.
# The OpenCode plugin sends this same token as its AGENT_ACTIVITY_TOKEN.
AGENT_ACTIVITY_TOKEN=replace-with-a-long-random-token

# OpenRouter key for Jev turn classification (https://openrouter.ai/api/alpha/decisions).
# Leave empty to run in heuristic-only mode (graceful degradation, no Jev calls).
OPENROUTER_API_KEY=

# --- OpenCode plugin side (set OUTSIDE this repo; shown here for reference) ---
# The plugin reads these from its environment (shell profile) or from plugin
# options in ~/.config/opencode/opencode.jsonc:
#   AGENT_ACTIVITY_URL=https://api.arvian.to/activity/turns
#   AGENT_ACTIVITY_TOKEN=<same value as above>

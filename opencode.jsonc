{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "Chrome DevTools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "Figma Desktop": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      }
    }
  },
  "policies": [
    {
      "action": "skill.use",
      "resource": "code-review",
      "effect": "deny"
    },
    {
      "action": "skill.use",
      "resource": "autofix",
      "effect": "deny"
    }
  ]
}

                    },
                    {
                      "type": "frame",
                      "id": "t6wBXy",
                      "name": "Perspective",
                      "clip": true,
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 14,
                      "children": [
                        {
                          "type": "text",
                          "id": "jZLkM",
                          "name": "Description",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "As a software developer with a UI design mindset, there's no doubt for me to bring AI into every stage of my workflow. From the very first question to the final polish, whether it's architectural or pixel perfection, I set the direction.",
                          "lineHeight": 1.5,
                          "fontFamily": "Plus Jakarta Sans",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "EEUMg",
                          "name": "Description",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "They're smart enough to help me on compressing execution loops and removing repetitive processes. AI lets me to iterate faster while staying deep in the details.",
                          "lineHeight": 1.5,
                          "fontFamily": "Plus Jakarta Sans",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "M3Cjck",

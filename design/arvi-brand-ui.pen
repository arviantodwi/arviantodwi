                        {
                          "type": "frame",
                          "id": "H6yvN",
                          "name": "Intro Copy",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 32,
                          "children": [
                            {
                              "type": "text",
                              "id": "Fg3Q3",
                              "name": "I'm a software developer and currently part of Automata Networks's SDE team. I specialize in Front End development with 10+ years of experience in the industry. Based in Indonesia, I primarily work remotely – which has allowed me to establish myself as an independent developer with a portfolio of 50+ worldwide projects. Beyond my professional life, I prioritize my role as a full-time dad and husband.",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": 778,
                              "content": "I'm a software developer currently seeking a new adventure in my next role. I specialize in Front End development and bring over 12+ years of experience in the tech industry; 8 years as UI Designer and 6 years as Front End Developer.\n\nI primarily work remotely at my home in Indonesia, which has enabled me to build a strong portfolio of 50+ projects with clients/companies around the world. Outside of work, I'm a full-time dad and husband, and also an intraday trader on commodity market.",
                              "lineHeight": 1.4375,
                              "fontFamily": "Plus Jakarta Sans",
                              "fontSize": 16,
                              "fontWeight": "normal",
                              "letterSpacing": 0.16
                            },

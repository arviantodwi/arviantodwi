                                      "x": 0,
                                      "y": 38,
                                      "name": "Hi, guest.",
                                      "fill": "$text-primary",
                                      "content": "Hi, buddy.\nNice to meet you!",
                                      "lineHeight": 1.25,
                                      "fontFamily": "Plus Jakarta Sans",
                                      "fontSize": 36,
